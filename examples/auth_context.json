      "path": "app/routes.py",
      "role_hint": "API route or controller",
      "lines": {
        "1": "\"\"\"HTTP login endpoint.\"\"\"",
        "2": "",
        "3": "from fastapi import FastAPI, HTTPException",
        "4": "",
        "5": "from .auth import authenticate, create_session",
        "6": "from .models import LoginRequest, LoginResponse",
        "7": "",
        "8": "app = FastAPI()",
        "9": "",
        "10": "",
        "11": "@app.post(\"/login\", response_model=LoginResponse)",
        "12": "def login(payload: LoginRequest):",
        "13": "    user = authenticate(payload.username, payload.password)",
        "14": "    if user is None:",
        "15": "        raise HTTPException(status_code=401, detail=\"Invalid credentials\")",
        "16": "    return LoginResponse(access_token=create_session(user[\"id\"]))"
      },
