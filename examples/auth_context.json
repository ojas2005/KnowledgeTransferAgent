      "role_hint": "application source",
      "lines": {
        "1": "\"\"\"Credential checks and signed session creation.\"\"\"",
        "2": "",
        "3": "import hashlib",
        "4": "import hmac",
        "5": "import os",
        "6": "",
        "7": "from .db import get_user",
        "8": "",
        "9": "",
        "10": "def verify_password(password: str, expected_hash: str) -> bool:",
        "11": "    supplied = hashlib.sha256(password.encode()).hexdigest()",
        "12": "    return hmac.compare_digest(supplied, expected_hash)",
        "13": "",
        "14": "",
        "15": "def authenticate(username: str, password: str):",
        "16": "    user = get_user(username)",
        "17": "    if not user or not verify_password(password, user[\"password_hash\"]):",
        "18": "        return None",
        "20": "",
        "21": "",
        "22": "def create_session(user_id: int) -> str:",
        "23": "    secret = [REDACTED]SESSION_SECRET\"]",
        "24": "    message = str(user_id).encode()",
        "25": "    signature = hmac.new(secret.encode(), message, hashlib.sha256).hexdigest()"
      },
